{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lx-cm-route",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "EDGE_LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENTRY_TICKET_REDEEMER",
        "class_name": "EntryTicketRedeemer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EntryTicketRedeemer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
