{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edge-app-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "EDGE_LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
