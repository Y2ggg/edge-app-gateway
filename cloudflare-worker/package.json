{
  "name": "edge-app-gateway",
  "version": "0.1.0",
  "description": "Zero-intrusion Cloudflare Workers application gateway and reverse proxy for Vercel apps",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "access-control",
    "application-gateway",
    "cloudflare-workers",
    "edge-gateway",
    "reverse-proxy",
    "vercel"
  ],
  "homepage": "https://github.com/Y2ggg/edge-app-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y2ggg/edge-app-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/Y2ggg/edge-app-gateway/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dashboard:build": "esbuild src/worker.js --bundle --format=esm --platform=browser --outfile=dashboard/worker.js",
    "deploy": "wrangler deploy",
    "deploy:config": "node scripts/deploy-variable-file.js",
    "deploy:check": "npm run repository:check && wrangler deploy --dry-run",
    "repository:check": "node scripts/check-repository-policy.js",
    "test": "npm run repository:check && node --test",
    "test:coverage": "npm run repository:check && node --test --experimental-test-coverage",
    "password:hash": "node scripts/hash-worker-password.js",
    "session:secret": "node scripts/generate-session-secret.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.115.0"
  }
}
